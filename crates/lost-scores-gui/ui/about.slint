import { AboutSlint } from "std-widgets.slint";
import { T } from "theme.slint";
import { State } from "state.slint";
import { PrimaryButton } from "widgets.slint";

component Credit inherits HorizontalLayout {
    in property <string> name;
    in property <string> licence;
    spacing: 8px;
    alignment: start;
    Text {
        text: root.name;
        color: T.lbl;
        font-size: 14px;
        font-weight: 500;
    }
    Text {
        text: root.licence;
        color: T.k;
        font-size: 13px;
    }
}

export component AboutSheet inherits Rectangle {
    background: #000000b0;
    TouchArea {
        clicked => {
            State.close-about();
        }
    }
    Rectangle {
        width: min(440px, parent.width - 40px);
        height: min(card.preferred-height, parent.height - 40px);
        border-radius: 12px;
        background: T.card;
        border-width: 2px;
        border-color: T.togb;
        TouchArea { }
        card := VerticalLayout {
            padding: 24px;
            spacing: 6px;
            Text {
                text: "osu! Lost Scores Analyzer";
                color: #ffffff;
                font-size: 20px;
                font-weight: 600;
            }
            Text {
                text: "Version " + State.version + " · MIT License";
                color: T.k2;
                font-size: 14px;
            }
            Rectangle { height: 12px; }
            Text {
                text: "Credits";
                color: T.lbl;
                font-size: 16px;
                font-weight: 600;
            }
            Credit { name: "Twemoji"; licence: "CC BY 4.0"; }
            Credit { name: "Font Awesome Free"; licence: "CC BY 4.0"; }
            Credit { name: "Fredoka"; licence: "OFL 1.1"; }
            Credit { name: "Slint"; licence: "GPLv3 or the royalty-free licence"; }
            Rectangle { height: 8px; }
            AboutSlint { }
            Rectangle { height: 10px; }
            PrimaryButton {
                height: 44px;
                text: "Close";
                clicked => {
                    State.close-about();
                }
            }
        }
    }
}
