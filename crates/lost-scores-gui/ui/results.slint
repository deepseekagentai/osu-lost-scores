import { ListView, ScrollView } from "std-widgets.slint";
import { T } from "theme.slint";
import { State, ScoreRow, FootItem, Preview } from "state.slint";
import { IconButton, PrimaryButton, SecondaryButton, TipArea, HintArea } from "widgets.slint";

component Hit inherits HorizontalLayout {
    in property <string> label;
    in property <int> value;
    in property <color> tint;
    spacing: 4px;
    alignment: start;
    Text {
        text: root.label;
        color: root.tint;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        text: root.value;
        color: #ffffff;
        font-size: 13.5px;
        vertical-alignment: center;
    }
}

component TitleLine inherits Rectangle {
    in property <string> title;
    in property <string> artist;
    in property <bool> lost;
    height: 20px;
    property <length> gap: 8px;
    property <length> lead: root.lost ? 46px : 0px;
    property <length> room: root.width - root.lead;
    property <length> t-pref: min(ttl.preferred-width, 420px);
    property <length> a-pref: art.preferred-width;
    property <bool> show-artist: root.artist != "" && root.room - root.gap - min(root.a-pref, 90px) >= 140px;
    property <length> a-w: root.show-artist ? min(root.a-pref, max(90px, root.room - root.gap - root.t-pref)) : 0px;
    property <length> t-w: max(0px, min(root.t-pref, root.room - (root.show-artist ? root.a-w + root.gap : 0px)));
    if root.lost: Rectangle {
        x: 0px;
        y: 1px;
        width: 38px;
        height: 17px;
        border-radius: 5px;
        background: T.lost;
        Text {
            text: "LOST";
            color: #2b1218;
            font-size: 10.5px;
            font-weight: 600;
        }
    }
    ttl := Text {
        x: root.lead;
        width: root.t-w;
        height: root.height;
        text: root.title;
        color: #ffffff;
        font-size: 15px;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: center;
    }
    art := Text {
        x: root.lead + root.t-w + root.gap;
        width: root.a-w;
        height: root.height;
        visible: root.show-artist;
        text: "by " + root.artist;
        color: T.by;
        font-size: 13px;
        overflow: elide;
        vertical-alignment: bottom;
    }
}

component DetailLine inherits Rectangle {
    in property <ScoreRow> item;
    callback open-link();
    height: 17px;
    property <length> gap: 12px;
    property <length> link-w: root.item.link != "" ? lprobe.preferred-width : 0px;
    property <length> chip-w: root.item.status != "" ? sprobe.preferred-width + 12px : 0px;
    property <string> replay-text: root.item.replay == 4 ? "replay" : root.item.replay == 3 ? "replay soon" : "";
    property <length> rchip-w: root.replay-text != "" ? rprobe.preferred-width + 12px : 0px;
    property <length> chip-part: (root.chip-w > 0px ? root.chip-w + root.gap : 0px) + (root.rchip-w > 0px ? root.rchip-w + (root.chip-w > 0px ? 6px : root.gap) : 0px);
    property <length> v-pref: min(ver.preferred-width, 260px);
    property <length> v-min: min(root.v-pref, 110px);
    property <length> m-pref: root.item.creator != "" ? map.preferred-width : 0px;
    property <length> d-full: full.preferred-width;
    property <length> d-short: short.preferred-width;
    property <bool> show-link: root.link-w > 0px && root.width - root.chip-part - root.link-w - root.gap >= root.v-min + root.gap + root.d-short;
    property <length> link-part: root.show-link ? root.link-w + root.gap : 0px;
    property <length> room: root.width - root.chip-part - root.link-part;
    property <bool> full-date: root.room >= root.v-pref + root.gap + root.d-full;
    property <bool> short-fits: root.room >= root.v-min + root.gap + root.d-short;
    property <length> d-w: root.full-date ? root.d-full : (root.short-fits ? root.d-short : 0px);
    property <bool> show-date: root.d-w > 0px;
    property <length> left: root.room - (root.show-date ? root.d-w + root.gap : 0px);
    property <length> m-avail: root.left - root.v-pref - root.gap;
    property <bool> show-map: root.m-pref > 0px && root.m-avail >= 110px;
    property <length> m-w: root.show-map ? min(root.m-pref, root.m-avail) : 0px;
    property <length> v-w: max(0px, min(root.v-pref, root.left));
    property <length> d-x: root.v-w + (root.show-map ? root.gap + root.m-w : 0px) + root.gap;
    property <length> end-x: root.show-date ? root.d-x + root.d-w : root.v-w + (root.show-map ? root.gap + root.m-w : 0px);
    ver := Text {
        x: 0px;
        width: root.v-w;
        height: root.height;
        text: root.item.version;
        color: T.acc;
        font-size: 12.5px;
        overflow: elide;
        vertical-alignment: center;
    }
    map := Text {
        x: root.v-w + root.gap;
        width: root.m-w;
        height: root.height;
        visible: root.show-map;
        text: "mapped by " + root.item.creator;
        color: T.meta;
        font-size: 12.5px;
        overflow: elide;
        vertical-alignment: center;
    }
    full := Text {
        visible: false;
        text: root.item.date;
        font-size: 12.5px;
    }
    short := Text {
        visible: false;
        text: root.item.date-short;
        font-size: 12.5px;
    }
    if root.show-date: Text {
        x: root.d-x;
        width: root.d-w;
        height: root.height;
        text: root.full-date ? root.item.date : root.item.date-short;
        color: T.meta;
        font-size: 12.5px;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.show-link: Rectangle {
        x: root.end-x + root.gap;
        width: root.link-w;
        height: root.height;
        bid := Text {
            accessible-role: none;
            y: 0;
            text: root.item.link;
            color: T.bid;
            font-size: 12.5px;
        }
        Rectangle {
            y: bid.preferred-height;
            height: 1px;
            background: #6b6380;
        }
        TouchArea {
            accessible-role: button;
            accessible-label: "Open " + root.item.link + " on osu!";
            accessible-action-default => {
                root.open-link();
            }
            mouse-cursor: pointer;
            clicked => {
                root.open-link();
            }
        }
    }
    lprobe := Text {
        visible: false;
        text: root.item.link;
        font-size: 12.5px;
    }
    sprobe := Text {
        visible: false;
        text: root.item.status;
        font-size: 11px;
        font-weight: 600;
    }
    rprobe := Text {
        visible: false;
        text: root.replay-text;
        font-size: 11px;
        font-weight: 600;
    }
    if root.replay-text != "": Rectangle {
        x: root.end-x + root.gap + root.link-part + (root.chip-w > 0px ? root.chip-w + 6px : 0px);
        y: 0px;
        width: root.rchip-w;
        height: 16px;
        border-radius: 4px;
        background: #2f4a2a;
        Text {
            text: root.replay-text;
            color: T.up;
            font-size: 11px;
            font-weight: 600;
        }
    }
    if root.item.status != "": Rectangle {
        x: root.end-x + root.gap + root.link-part;
        y: 0px;
        width: root.chip-w;
        height: 16px;
        border-radius: 4px;
        background: root.item.status-color;
        status := Text {
            text: root.item.status;
            color: root.item.status-text;
            font-size: 11px;
            font-weight: 600;
        }
    }
}

component RowView inherits Rectangle {
    in property <ScoreRow> item;
    in property <bool> narrow;
    in property <bool> highlighted;
    callback copy();
    callback open-link();
    height: 58px;
    border-radius: 8px;
    clip: true;
    property <bool> faded: !root.item.fresh;
    opacity: root.faded ? 1 : 0;
    animate opacity {
        duration: 200ms;
        easing: ease-out;
    }
    Timer {
        running: !root.faded;
        interval: 30ms;
        triggered => {
            root.faded = true;
        }
    }
    background: root.item.lost ? T.row-lost : T.row;
    ta := TouchArea {
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.copy();
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 2px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 14px;
        if root.item.place != "": Text {
            width: 34px;
            text: root.item.place;
            color: T.meta;
            font-size: 13px;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.item.rank-color;
                Text {
                    text: root.item.rank;
                    color: T.ink;
                    font-size: 15px;
                    font-weight: 600;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 1;
            min-width: 140px;
            TitleLine {
                title: root.item.title;
                artist: root.item.artist;
                lost: root.item.lost;
            }
            DetailLine {
                item: root.item;
                open-link => {
                    root.open-link();
                }
            }
        }
        HorizontalLayout {
            width: State.mods-col;
            spacing: 3px;
            alignment: end;
            for m in root.item.mods: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 17px;
                    border-radius: 5px;
                    background: m.color;
                    Text {
                        text: m.text;
                        color: T.ink;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
            }
        }
        if !root.narrow: HorizontalLayout {
            width: 172px;
            spacing: 12px;
            alignment: start;
            Hit { label: "100"; value: root.item.c100; tint: #b3d944; }
            Hit { label: "50"; value: root.item.c50; tint: #ffcc22; }
            Hit { label: "miss"; value: root.item.miss; tint: #ff6666; }
        }
        if !root.narrow: Text {
            width: 96px;
            text: root.item.score;
            color: #cbc6d6;
            font-size: 13.5px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 76px;
            text: root.item.acc;
            color: #ffffff;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            width: root.narrow ? 100px : 126px;
            background: T.bg;
            border-radius: 6px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 1px;
                    Text {
                        text: root.item.pp;
                        color: root.item.lost ? T.lost : #ffffff;
                        font-size: 18px;
                        font-weight: 600;
                        vertical-alignment: bottom;
                    }
                    Text {
                        text: "pp";
                        color: root.item.lost ? T.lost : T.k;
                        font-size: 12px;
                        vertical-alignment: bottom;
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 4px;
                    if root.item.sub != "": Text {
                        text: root.item.sub;
                        color: T.k;
                        font-size: 11.5px;
                    }
                    if root.item.sub-red != "": VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/i-trend-down.svg");
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                            colorize: T.down;
                        }
                    }
                    if root.item.sub-red != "": Text {
                        text: root.item.sub-red;
                        color: T.down;
                        font-size: 12px;
                        font-weight: 500;
                    }
                }
            }
            if root.item.kept-tip != "": HintArea {
                tip: root.item.kept-tip;
                anchor: parent.absolute-position;
                anchor-height: parent.height;
            }
        }
    }
    Rectangle {
        background: root.highlighted ? #a28aea22 : transparent;
        border-radius: 8px;
        border-width: 2px;
        border-color: root.highlighted || ta.has-hover ? T.acc : transparent;
        animate border-color { duration: 150ms; }
    }
}

component Tab inherits VerticalLayout {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    spacing: 7px;
    Text {
        accessible-role: none;
        text: root.text;
        color: root.active || ta.has-hover ? #ffffff : T.k;
        font-size: 16px;
        font-weight: 500;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    Rectangle {
        height: 3px;
        border-radius: 2px;
        background: root.active ? T.acc : transparent;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <int> column;
    in property <LayoutAlignment> place: start;
    property <bool> active: State.sort-column == root.column;
    height: 24px;
    ta := TouchArea {
        accessible-role: button;
        accessible-label: "Sort by " + root.text;
        accessible-action-default => {
            State.sort-by(root.column);
        }
        mouse-cursor: pointer;
        clicked => {
            State.sort-by(root.column);
        }
    }
    HorizontalLayout {
        alignment: root.place;
        spacing: 4px;
        Text {
            accessible-role: none;
            text: root.text;
            color: root.active || ta.has-hover ? #ffffff : T.k;
            font-size: 12.5px;
            vertical-alignment: center;
        }
        if root.active: Text {
            accessible-role: none;
            text: State.sort-desc ? "▼" : "▲";
            color: T.acc;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

component BackButton inherits Rectangle {
    callback clicked;
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: T.btn;
    border-width: 2px;
    border-color: ta.has-hover ? T.acc : transparent;
    animate border-color { duration: 150ms; }
    Text {
        text: "\u{2039}";
        color: #ffffff;
        font-size: 26px;
        font-weight: 600;
    }
    ta := TipArea {
        accessible-role: button;
        accessible-label: "Back";
        tip: "Back";
        anchor: root.absolute-position;
        anchor-height: root.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component RowTrash inherits Rectangle {
    in property <bool> lit;
    in-out property <bool> over;
    callback clicked;
    width: 28px;
    height: 28px;
    opacity: root.lit || root.over ? 1 : 0;
    IconButton {
        width: 28px;
        height: 28px;
        icon: @image-url("../assets/i-xmark.svg");
        tip: "Delete this scan";
        outlined: false;
        changed hovered => {
            root.over = self.hovered;
        }
        clicked => {
            root.clicked();
        }
    }
}

component ScanSelector inherits Rectangle {
    width: row.preferred-width + 28px;
    height: 42px;
    border-radius: 10px;
    background: T.card;
    border-width: 2px;
    border-color: ta.has-hover || State.scans-open ? T.acc : transparent;
    animate border-color { duration: 150ms; }
    ta := TouchArea {
        accessible-role: button;
        accessible-label: "Scans";
        accessible-action-default => {
            State.scans-open = !State.scans-open;
        }
        mouse-cursor: pointer;
        clicked => {
            State.scans-open = !State.scans-open;
        }
    }
    row := HorizontalLayout {
        x: 14px;
        width: parent.width - 28px;
        alignment: start;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../assets/i-history.svg");
                width: 16px;
                height: 16px;
                image-fit: contain;
                colorize: T.ibicon;
            }
        }
        Text {
            text: State.scan-date;
            color: #ffffff;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../assets/i-caret.svg");
                width: 12px;
                height: 12px;
                image-fit: contain;
                colorize: T.ibicon;
            }
        }
    }
}

component SearchField inherits Rectangle {
    height: 40px;
    border-radius: 8px;
    background: T.field;
    border-width: 2px;
    border-color: input.has-focus || ta.has-hover ? T.acc : transparent;
    animate border-color { duration: 150ms; }
    ta := TouchArea { mouse-cursor: text; }
    if input.text == "": Text {
        x: 14px;
        text: "Search in table...";
        color: T.arrow;
        font-size: 14px;
        font-italic: true;
        vertical-alignment: center;
    }
    input := TextInput {
        text <=> State.search-text;
        x: 14px;
        width: parent.width - 28px - counter.preferred-width - 6px;
        color: #ffffff;
        font-size: 14px;
        vertical-alignment: center;
        single-line: true;
        init => {
            self.focus();
        }
        edited => {
            State.search-changed(self.text);
        }
    }
    counter := Text {
        x: parent.width - self.width - 12px;
        text: State.search-label;
        color: T.k;
        font-size: 13px;
        vertical-alignment: center;
    }
}

component SearchToggle inherits VerticalLayout {
    alignment: center;
    IconButton {
        width: 42px;
        height: 42px;
        icon: @image-url("../assets/i-search.svg");
        tip: State.search-open ? "Close the search" : "Search in the table (Ctrl+F)";
        clicked => {
            if (State.search-open) {
                State.search-text = "";
                State.search-open = false;
                State.search-changed("");
            } else {
                State.search-open = true;
            }
        }
    }
}

component SendPill inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> marked;
    in property <color> mark;
    in property <bool> compact;
    callback clicked;
    width: row.preferred-width + 26px;
    height: 40px;
    border-radius: 10px;
    background: T.btn;
    opacity: root.enabled ? 1 : 0.45;
    border-width: 2px;
    border-color: root.enabled && ta.has-hover ? T.acc : transparent;
    animate border-color { duration: 150ms; }
    row := HorizontalLayout {
        x: 13px;
        width: parent.width - 26px;
        spacing: 8px;
        alignment: center;
        if root.marked: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.mark;
            }
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 18px;
                height: 16px;
                image-fit: contain;
                colorize: #ffffff;
            }
        }
        if !root.compact: Text {
            accessible-role: none;
            text: root.text;
            color: #ffffff;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    ta := TipArea {
        accessible-role: button;
        accessible-label: root.text;
        tip: root.tip;
        anchor: root.absolute-position;
        anchor-height: root.height;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component TrashPill inherits Rectangle {
    in property <bool> enabled: true;
    width: 38px;
    height: 40px;
    border-radius: 10px;
    background: T.btn;
    opacity: root.enabled ? 1 : 0.45;
    border-width: 2px;
    border-color: root.enabled && ta.has-hover ? T.acc : transparent;
    animate border-color { duration: 150ms; }
    Image {
        width: 16px;
        height: 16px;
        source: @image-url("../assets/i-trash.svg");
        colorize: #ffffff;
        image-fit: contain;
    }
    ta := TipArea {
        accessible-role: button;
        accessible-label: "Delete from the server";
        tip: "Delete this scan from the Lost Scores server";
        anchor: root.absolute-position;
        anchor-height: root.height;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.enabled) {
                State.ask-unsend();
            }
        }
    }
}

component SendButton inherits HorizontalLayout {
    in property <bool> narrow;
    property <bool> ready: State.can-send && !State.busy && !State.sending;
    spacing: 4px;
    if !State.sent-public: VerticalLayout {
        alignment: center;
        SendPill {
            text: "Share";
            icon: @image-url("../assets/i-cloud-up.svg");
            enabled: root.ready;
            tip: State.share-tip;
            clicked => {
                State.share();
            }
        }
    }
    if State.sent-public: VerticalLayout {
        alignment: center;
        SendPill {
            text: "Unpublish";
            icon: @image-url("../assets/i-eye-slash.svg");
            marked: true;
            mark: State.sent-blocked ? T.down : (State.sent-verified ? T.up : T.acc);
            compact: root.narrow;
            enabled: root.ready;
            tip: State.sent-state;
            clicked => {
                State.unpublish-scan();
            }
        }
    }
    if State.sent-state != "": VerticalLayout {
        alignment: center;
        TrashPill {
            enabled: root.ready;
        }
    }
}

component OfferCard inherits Rectangle {
    height: body.preferred-height;
    border-radius: 12px;
    background: T.card;
    border-width: 2px;
    border-color: T.acc;
    body := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/i-trend-down.svg");
                    width: 26px;
                    height: 26px;
                    image-fit: contain;
                    colorize: T.lost;
                }
            }
            Text {
                text: "Hall of Copium";
                color: #ffffff;
                font-size: 22px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        StyledText {
            text: @markdown("You lost \{State.offer-lost} pp (\{State.offer-before} \u{2192} <font color=\"\{T.up}\">\{State.offer-after} pp</font>). Show it to other players?");
            default-color: T.ftext;
            default-font-size: 17px;
        }
        HorizontalLayout {
            spacing: 10px;
            if State.replays-in-top > 0: VerticalLayout {
                alignment: center;
                choice := Rectangle {
                    property <string> label: State.replays-in-top == 1 ? "Share the replay too" : "Share \{State.replays-in-top} replays too";
                    width: choice-row.preferred-width;
                    height: choice-row.preferred-height;
                    choice-row := HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 6px;
                            background: State.offer-with-replays ? T.acc2 : T.tog;
                            border-width: 1.5px;
                            border-color: State.offer-with-replays ? T.acc : T.togb;
                            if State.offer-with-replays: Image {
                                x: 3px;
                                y: 3px;
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/i-check.svg");
                                colorize: #ffffff;
                                image-fit: contain;
                            }
                        }
                        Text {
                            text: choice.label;
                            accessible-role: none;
                            color: T.ftext;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        accessible-role: checkbox;
                        accessible-checked: State.offer-with-replays;
                        accessible-label: choice.label;
                        accessible-action-default => {
                            State.offer-with-replays = !State.offer-with-replays;
                        }
                        mouse-cursor: pointer;
                        clicked => {
                            State.offer-with-replays = !State.offer-with-replays;
                        }
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            SecondaryButton {
                width: 110px;
                height: 40px;
                text: "Not now";
                text-size: 15px;
                clicked => {
                    State.dismiss-offer();
                }
            }
            PrimaryButton {
                width: 150px;
                height: 40px;
                text: "Publish";
                enabled: State.can-send && !State.busy && !State.sending;
                tip: State.busy ? "Wait for the scan to finish" : "Send this scan and show it in the Hall of Copium";
                clicked => {
                    State.publish-offer();
                }
            }
        }
    }
}

component CatboxButton inherits VerticalLayout {
    alignment: center;
    button := Rectangle {
        width: row.preferred-width + 26px;
        height: 40px;
        border-radius: 10px;
        background: T.btn;
        border-width: 2px;
        border-color: State.catbox-tone > 0 ? T.up : (State.catbox-tone < 0 ? T.down : (ta.has-hover && !State.catbox-busy ? T.acc : transparent));
        animate border-color { duration: 150ms; }
        row := HorizontalLayout {
            x: 13px;
            width: parent.width - 26px;
            spacing: 8px;
            alignment: center;
            if State.catbox-label == "": VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/i-cloud-up.svg");
                    width: 20px;
                    height: 16px;
                    image-fit: contain;
                    colorize: #ffffff;
                }
            }
            Text {
                accessible-role: none;
                text: State.catbox-label != "" ? State.catbox-label : "catbox";
                color: State.catbox-busy ? T.k : #ffffff;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
        ta := TipArea {
            accessible-role: AccessibleRole.button;
            accessible-label: State.catbox-label != "" ? State.catbox-label : "catbox";
            tip: State.catbox-error != "" ? State.catbox-error : "Upload all pictures to catbox.moe for public links";
            anchor: button.absolute-position;
            anchor-height: button.height;
            mouse-cursor: State.catbox-busy ? MouseCursor.default : MouseCursor.pointer;
            clicked => {
                if (!State.catbox-busy) {
                    State.upload-all();
                }
            }
        }
    }
}

component PreviewCard inherits Rectangle {
    in property <Preview> item;
    in property <int> index;
    property <length> span: max(root.item.width, 160px);
    property <length> shift: max(0px, (root.width - root.span) / 2);
    height: 12px + root.item.height + 18px;
    if root.item.ready: Image {
        x: root.shift;
        y: 12px;
        source: root.item.image;
        width: root.item.width;
        height: root.item.height;
        image-fit: fill;
        image-rendering: pixelated;
        opacity: pic.has-hover ? 0.86 : 1;
        animate opacity { duration: 120ms; }
    }
    if !root.item.ready: Text {
        x: 0px;
        y: 12px;
        text: "The " + root.item.label + " preview could not be made. Open the image to see it.";
        color: T.k;
        font-size: 14px;
        font-italic: true;
    }
    pic := TipArea {
        x: root.item.ready ? root.shift : 0px;
        y: 12px;
        width: root.item.ready ? root.item.width : root.width;
        height: root.item.ready ? root.item.height : 24px;
        tip: "Click to open, right-click to copy";
        anchor: { x: self.absolute-position.x + self.mouse-x, y: self.absolute-position.y + self.mouse-y };
        anchor-height: 16px;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.item.label + " picture";
        clicked => {
            State.open-image(root.index);
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                State.picture-menu-x = self.absolute-position.x + self.mouse-x;
                State.picture-menu-y = self.absolute-position.y + self.mouse-y;
                State.picture-menu-index = root.index;
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: ta.has-hover ? T.btn : transparent;
    Text {
        accessible-role: none;
        x: 12px;
        text: root.text;
        color: #ffffff;
        font-size: 14px;
        vertical-alignment: center;
    }
    ta := TouchArea {
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => {
            root.clicked();
        }
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component PictureArrows inherits HorizontalLayout {
    spacing: 6px;
    IconButton {
        width: 40px;
        height: 40px;
        icon: @image-url("../assets/i-chev-up.svg");
        tip: "Previous picture";
        enabled: State.prev-picture-ok;
        clicked => {
            State.step-picture(-1);
        }
    }
    IconButton {
        width: 40px;
        height: 40px;
        icon: @image-url("../assets/i-chev-down.svg");
        tip: "Next picture";
        enabled: State.next-picture-ok;
        clicked => {
            State.step-picture(1);
        }
    }
}

component ModeSegment inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> hovered;
    accessible-role: button;
    accessible-label: root.label;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        colorize: root.active || root.hovered ? #ffffff : T.k;
        image-fit: contain;
    }
}

component TableSegment inherits Rectangle {
    in property <int> count;
    in property <bool> active;
    in property <bool> hovered;
    property <length> content: 18px + (root.count > 0 ? 6px + number.preferred-width : 0px);
    width: root.count > 0 ? root.content + 24px : 44px;
    accessible-role: button;
    accessible-label: "Table";
    Image {
        x: (parent.width - root.content) / 2;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: @image-url("../assets/i-list.svg");
        colorize: root.active || root.hovered ? #ffffff : T.k;
        image-fit: contain;
    }
    number := Text {
        x: (parent.width - root.content) / 2 + 24px;
        y: (parent.height - self.height) / 2;
        text: root.count > 0 ? "\{root.count}" : "";
        color: root.active || root.hovered ? #ffffff : T.k;
        font-size: 14px;
        font-weight: 600;
    }
}

component ModeThumb inherits Rectangle {
    border-radius: 8px;
    background: T.tog-on;
    border-width: 2px;
    border-color: T.acc;
}

component ModeSwitch inherits Rectangle {
    in property <bool> compact;
    property <length> segment: 44px;
    width: 3px + root.segment + 2px + table.width + 3px;
    height: 40px;
    border-radius: 10px;
    background: T.btn;
    ModeThumb {
        x: State.images-shown ? 3px : 5px + root.segment;
        y: 3px;
        width: State.images-shown ? root.segment : table.width;
        height: root.height - 6px;
        animate x, width {
            duration: 180ms;
            easing: ease-out;
        }
    }
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        ModeSegment {
            width: root.segment;
            icon: @image-url("../assets/i-image.svg");
            label: "Images";
            active: State.images-shown;
            hovered: ta.has-hover;
        }
        table := TableSegment {
            count: root.compact ? 0 : State.lost-count;
            active: !State.images-shown;
            hovered: ta.has-hover;
        }
    }
    ta := TipArea {
        accessible-role: button;
        accessible-label: State.images-shown ? "Show the table" : "Show the images";
        tip: State.images-shown ? "Show the table" : "Show the images to share";
        anchor: root.absolute-position;
        anchor-height: root.height;
        mouse-cursor: pointer;
        clicked => {
            if (State.images-shown) {
                State.set-tab(State.tab);
            } else {
                State.show-images();
            }
        }
    }
}

component FootPair inherits HorizontalLayout {
    in property <FootItem> item;
    in property <bool> first;
    in property <bool> shown: true;
    visible: root.shown;
    width: root.shown ? self.preferred-width : 0px;
    spacing: 6px;
    padding-left: root.first ? 0px : 6px;
    if !root.first: Text {
        text: "·";
        color: #6b6576;
        font-size: 14.5px;
        vertical-alignment: center;
    }
    Text {
        text: root.item.label;
        color: #b8b2c4;
        font-size: 14.5px;
        vertical-alignment: center;
    }
    Text {
        text: root.item.value;
        color: root.item.tail == "" && root.item.tone > 0 ? T.up : (root.item.tail == "" && root.item.tone < 0 ? T.down : #ffffff);
        font-size: 14.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
    if root.item.tail != "": Text {
        text: root.item.tail;
        color: root.item.tone > 0 ? T.up : (root.item.tone < 0 ? T.down : #ffffff);
        font-size: 14.5px;
        font-weight: 600;
        vertical-alignment: center;
    }
}

export component ResultsPanel inherits Rectangle {
    in property <bool> show-back: false;
    property <bool> narrow: true;
    property <bool> switch-up: false;
    property <bool> tight: true;
    property <bool> split-foot: root.narrow && State.foot.length > 3;
    property <int> jump: State.jump-serial;
    property <float> mode-t: State.images-shown ? 1 : 0;
    animate mode-t {
        duration: 220ms;
        easing: ease-in-out;
    }
    property <bool> view-images: root.mode-t > 0.5;
    property <float> offer-t: State.has-results && State.offer-shown ? 1 : 0;
    animate offer-t {
        duration: 220ms;
        easing: ease-out;
    }
    property <float> body-fade: Math.abs(root.mode-t - 0.5) * 2;
    init => {
        root.narrow = root.width < 980px;
        root.tight = root.width < 760px;
        root.switch-up = root.width >= 800px;
        State.preview-room-changed(root.width - 66px);
    }
    changed width => {
        root.narrow = root.width < 980px;
        root.tight = root.width < 760px;
        root.switch-up = root.width >= 800px;
        State.preview-room-changed(root.width - 66px);
    }
    property <length> view-y: list.content-y;
    property <bool> gliding: false;
    property <length> glide-from;
    property <length> glide-to;
    property <duration> glide-start;
    changed view-y => {
        State.scroll-y = root.view-y;
    }
    property <bool> glide-images: false;
    property <length> images-top: -imgs.content-y;
    property <length> images-room: imgs.visible-height;
    property <length> images-total: imgs.content-height;
    changed images-top => {
        State.images-scrolled(root.images-top, root.images-room, root.images-total);
    }
    changed images-room => {
        State.images-scrolled(root.images-top, root.images-room, root.images-total);
    }
    changed images-total => {
        State.images-scrolled(root.images-top, root.images-room, root.images-total);
    }
    changed jump => {
        root.glide-images = State.images-shown;
        if (root.glide-images) {
            root.glide-to = Math.min(0px, Math.max(State.jump-y, imgs.visible-height - imgs.content-height));
        } else {
            root.glide-to = Math.min(0px, Math.max(State.jump-y, list.visible-height - list.content-height));
        }
        if (State.jump-animated) {
            root.glide-from = root.glide-images ? imgs.content-y : list.content-y;
            root.glide-start = animation-tick();
            root.gliding = true;
        } else {
            root.gliding = false;
            if (root.glide-images) {
                imgs.content-y = root.glide-to;
            } else {
                list.content-y = root.glide-to;
            }
        }
    }
    Timer {
        running: root.gliding;
        interval: 16ms;
        triggered => {
            let t = Math.min(1.0, (animation-tick() - root.glide-start) / 250ms);
            let eased = 1.0 - (1.0 - t) * (1.0 - t) * (1.0 - t);
            let y = root.glide-from + (root.glide-to - root.glide-from) * eased;
            if (root.glide-images) {
                imgs.content-y = y;
            } else {
                list.content-y = y;
            }
            if (t >= 1.0) {
                root.gliding = false;
            }
        }
    }
    VerticalLayout {
        padding-left: 26px;
        padding-right: 26px;
        padding-top: 24px;
        padding-bottom: 18px;
        spacing: 12px;
        VerticalLayout {
            spacing: 0;
            vertical-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 0;
                property <bool> searching: State.search-open && !root.view-images;
                if root.show-back: BackButton {
                    clicked => {
                        State.back();
                    }
                }
                if State.has-results && !(root.narrow && self.searching): ScanSelector { }
                if State.has-results && !(root.narrow && self.searching): SendButton {
                narrow: root.tight;
            }
                if !self.searching: Rectangle { horizontal-stretch: 1; }
                if self.searching: SearchField {
                    horizontal-stretch: 1;
                    min-width: 120px;
                    opacity: root.body-fade;
                }
                if State.has-results && !root.view-images: SearchToggle {
                    opacity: root.body-fade;
                }
                if State.has-results && root.view-images && State.has-images: CatboxButton {
                    opacity: root.body-fade;
                }
                if State.has-results: ModeSwitch {
                    compact: root.narrow && State.catbox-label != "";
                }
            }
            offer-slot := Rectangle {
                visible: root.offer-t > 0;
                height: (12px + offer-card.preferred-height) * root.offer-t;
                clip: true;
                offer-card := OfferCard {
                    y: 12px;
                    width: parent.width;
                    height: self.preferred-height;
                    opacity: root.offer-t;
                }
            }
        }
        if !State.has-results: Text {
            vertical-stretch: 1;
            text: "No analysis results found. Please run a scan first.";
            color: T.k;
            font-size: 16px;
            font-italic: true;
            horizontal-alignment: center;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        if State.has-results && !root.view-images: VerticalLayout {
            spacing: 0px;
            vertical-stretch: 0;
            opacity: root.body-fade;
            HorizontalLayout {
                spacing: 28px;
                alignment: start;
                Tab {
                    text: "Lost Scores";
                    active: State.tab == 0;
                    clicked => {
                        State.set-tab(0);
                    }
                }
                Tab {
                    text: "Online Top";
                    active: State.tab == 1;
                    clicked => {
                        State.set-tab(1);
                    }
                }
                Tab {
                    text: "Potential Top";
                    active: State.tab == 2;
                    clicked => {
                        State.set-tab(2);
                    }
                }
            }
            Rectangle {
                height: 2px;
                background: T.divider;
            }
        }
        if State.has-results && !root.view-images: HorizontalLayout {
            opacity: root.body-fade;
            padding-left: 12px;
            padding-right: 16px;
            spacing: 14px;
            vertical-stretch: 0;
            Rectangle { width: State.tab == 0 ? 44px : 92px; }
            HeaderCell {
                horizontal-stretch: 1;
                min-width: 140px;
                text: "Beatmap";
                column: 0;
            }
            HeaderCell {
                width: State.mods-col;
                text: "Mods";
                column: 1;
                place: end;
            }
            if !root.narrow: HeaderCell {
                width: 172px;
                text: "Hits";
                column: 2;
            }
            if !root.narrow: HeaderCell {
                width: 96px;
                text: "Score";
                column: 3;
                place: end;
            }
            HeaderCell {
                width: 76px;
                text: "Accuracy";
                column: 4;
                place: end;
            }
            HeaderCell {
                width: root.narrow ? 100px : 126px;
                text: "PP";
                column: 5;
                place: center;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            opacity: root.body-fade;
            list := ListView {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                visible: !root.view-images;
                for entry[i] in State.rows: Rectangle {
                    height: 64px;
                    RowView {
                        y: 3px;
                        width: parent.width - 14px;
                        item: entry;
                        narrow: root.narrow;
                        copy => {
                            State.copy-row(i);
                        }
                        open-link => {
                            State.open-beatmap(entry.beatmap-id);
                        }
                    }
                }
            }
            imgs := ScrollView {
                x: 0px;
                y: 6px;
                width: parent.width;
                height: parent.height - 6px;
                visible: root.view-images && State.has-images;
                VerticalLayout {
                    for item[i] in State.previews: PreviewCard {
                        item: item;
                        index: i;
                    }
                }
            }
            if root.view-images && !State.has-images: Text {
                x: 0px;
                y: 12px;
                width: parent.width;
                text: "This scan has no images. Images are made after every scan from now on.";
                color: T.k;
                font-size: 14px;
                font-italic: true;
                wrap: word-wrap;
            }
            if root.view-images && State.has-images: PictureArrows {
                x: parent.width - self.preferred-width - 24px;
                y: parent.height - 40px - 12px;
            }
        }
        if State.has-results && !root.view-images: Rectangle {
            opacity: root.body-fade;
            height: root.split-foot ? 76px : 46px;
            border-radius: 10px;
            background: T.card;
            VerticalLayout {
                x: 18px;
                alignment: center;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    for item[i] in State.foot: FootPair {
                        shown: !root.split-foot || i < 3;
                        item: item;
                        first: i == 0;
                    }
                }
                if root.split-foot: HorizontalLayout {
                    spacing: 0px;
                    alignment: start;
                    for item[i] in State.foot: FootPair {
                        shown: i >= 3;
                        item: item;
                        first: i == 3;
                    }
                }
            }
        }
    }
    if State.scans-open: TouchArea {
        clicked => {
            State.scans-open = false;
        }
    }
    if State.picture-menu-index >= 0: TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                State.picture-menu-index = -1;
            }
        }
    }
    if State.picture-menu-index >= 0: Rectangle {
        x: max(8px, min(State.picture-menu-x - root.absolute-position.x, root.width - self.width - 8px));
        y: max(8px, min(State.picture-menu-y - root.absolute-position.y, root.height - self.height - 8px));
        width: 176px;
        height: 12px + 2 * 34px + 2px;
        border-radius: 10px;
        background: T.card;
        border-width: 2px;
        border-color: T.togb;
        TouchArea { }
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            MenuRow {
                text: "Copy image";
                clicked => {
                    let index = State.picture-menu-index;
                    State.picture-menu-index = -1;
                    State.copy-image(index);
                }
            }
            MenuRow {
                text: "Open";
                clicked => {
                    let index = State.picture-menu-index;
                    State.picture-menu-index = -1;
                    State.open-image(index);
                }
            }
        }
    }
    if State.scans-open: scans-menu := Rectangle {
        property <float> shown;
        animate shown {
            duration: 150ms;
            easing: ease-out;
        }
        init => {
            self.shown = 1;
        }
        opacity: self.shown;
        property <length> footer: (State.scans.length > 1 ? 9px + 30px : 0px) + 9px + 30px;
        property <length> list-height: min(State.scans.length * 34px + (State.scans.length > 1 ? 26px : 0px), 380px - 16px - self.footer);
        x: root.show-back ? 74px : 26px;
        y: 24px + 42px + 6px - (1 - self.shown) * 6px;
        width: 320px;
        height: 16px + self.list-height + self.footer;
        border-radius: 10px;
        background: T.card;
        border-width: 2px;
        border-color: T.togb;
        TouchArea { }
        VerticalLayout {
            padding: 8px;
            scans-list := ListView {
                height: scans-menu.list-height;
                for label[i] in State.scans: VerticalLayout {
                    if i == 1: Text {
                        height: 26px;
                        text: "Older scans";
                        color: T.k;
                        font-size: 12.5px;
                        font-italic: true;
                        vertical-alignment: center;
                    }
                    row := Rectangle {
                        height: 34px;
                        property <bool> trash-over;
                        border-radius: 6px;
                        background: ta.has-hover || row.trash-over ? T.btn : transparent;
                        property <int> mark: State.scan-marks[i];
                        date := Text {
                            accessible-role: none;
                            x: 10px;
                            text: label;
                            color: i == State.scan-selected ? T.acc : #ffffff;
                            font-size: 14px;
                            font-weight: i == State.scan-selected ? 600 : 400;
                            vertical-alignment: center;
                        }
                        if row.mark > 0: Rectangle {
                            x: date.x + date.preferred-width + 8px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: row.mark == 3 ? T.down : (row.mark == 2 ? T.up : T.acc);
                        }
                        ta := TouchArea {
                            accessible-role: button;
                            accessible-label: row.mark > 0 ? label + ", published" : label;
                            accessible-action-default => {
                                State.select-scan(i);
                            }
                            mouse-cursor: pointer;
                            clicked => {
                                State.select-scan(i);
                            }
                        }
                        if i > 0: RowTrash {
                            x: parent.width - self.width - 4px - (scans-list.content-height > scans-list.visible-height ? 16px : 0px);
                            y: 3px;
                            lit: ta.has-hover;
                            over <=> row.trash-over;
                            clicked => {
                                State.delete-scan(i);
                            }
                        }
                    }
                }
            }
            if State.scans.length > 1: Rectangle {
                height: 9px;
                Rectangle {
                    y: 4px;
                    x: 4px;
                    width: parent.width - 8px;
                    height: 1px;
                    background: T.togb;
                }
            }
            if State.scans.length > 1: Rectangle {
                height: 30px;
                border-radius: 6px;
                background: older-ta.has-hover ? T.btn : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 7px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/i-trash.svg");
                            width: 12px;
                            height: 12px;
                            image-fit: contain;
                            colorize: older-ta.has-hover ? #ff6666 : T.k;
                        }
                    }
                    Text {
                        accessible-role: none;
                        text: "Delete older scans";
                        color: older-ta.has-hover ? #ff6666 : T.k;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                }
                older-ta := TouchArea {
                    accessible-role: button;
                    accessible-label: "Delete older scans";
                    accessible-action-default => {
                        State.delete-older-scans();
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        State.delete-older-scans();
                    }
                }
            }
            Rectangle {
                height: 9px;
                Rectangle {
                    y: 4px;
                    x: 4px;
                    width: parent.width - 8px;
                    height: 1px;
                    background: T.togb;
                }
            }
            Rectangle {
                height: 30px;
                border-radius: 6px;
                background: folder-ta.has-hover ? T.btn : transparent;
                HorizontalLayout {
                    padding-left: 10px;
                    spacing: 7px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/i-folder.svg");
                            width: 13px;
                            height: 13px;
                            image-fit: contain;
                            colorize: T.ibicon;
                        }
                    }
                    Text {
                        accessible-role: none;
                        text: "Open the scan folder";
                        color: #ffffff;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                folder-ta := TouchArea {
                    accessible-role: button;
                    accessible-label: "Open the scan folder";
                    accessible-action-default => {
                        State.scans-open = false;
                        State.open-scan-folder();
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        State.scans-open = false;
                        State.open-scan-folder();
                    }
                }
            }
        }
    }
    if State.copied: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 110px;
        width: copied-text.preferred-width + 28px;
        height: 36px;
        border-radius: 8px;
        background: #0c0b10;
        border-width: 1px;
        border-color: T.togb;
        copied-text := Text {
            text: State.copied-text;
            color: T.ftext;
            font-size: 13.5px;
        }
    }
}
