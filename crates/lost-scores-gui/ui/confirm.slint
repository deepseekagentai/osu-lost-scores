import { T } from "theme.slint";
import { PrimaryButton, SecondaryButton } from "widgets.slint";

export component ConfirmSheet inherits Rectangle {
    in property <string> message;
    in property <string> ok-text;
    callback cancel();
    callback ok();
    background: #000000b0;
    TouchArea {
        clicked => {
            root.cancel();
        }
    }
    Rectangle {
        width: min(380px, parent.width - 40px);
        height: card.preferred-height;
        border-radius: 12px;
        background: T.card;
        border-width: 2px;
        border-color: T.togb;
        TouchArea { }
        card := VerticalLayout {
            padding: 22px;
            spacing: 18px;
            Text {
                text: root.message;
                color: #ffffff;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                SecondaryButton {
                    height: 40px;
                    min-width: 120px;
                    text: "Cancel";
                    text-size: 16px;
                    clicked => {
                        root.cancel();
                    }
                }
                PrimaryButton {
                    height: 40px;
                    text: root.ok-text;
                    clicked => {
                        root.ok();
                    }
                }
            }
        }
    }
}
