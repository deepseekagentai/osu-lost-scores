import { T } from "theme.slint";
import { State } from "state.slint";
import { PrimaryButton, SecondaryButton } from "widgets.slint";

export component ConfirmSheet inherits Rectangle {
    background: #000000b0;
    TouchArea {
        clicked => {
            State.cancel-logout();
        }
    }
    Rectangle {
        width: min(380px, parent.width - 40px);
        height: card.preferred-height;
        border-radius: 12px;
        background: T.card;
        border-width: 2px;
        border-color: T.togb;
        TouchArea { }
        card := VerticalLayout {
            padding: 22px;
            spacing: 18px;
            Text {
                text: "Are you sure you want to log out?";
                color: #ffffff;
                font-size: 18px;
                font-weight: 600;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 10px;
                SecondaryButton {
                    height: 40px;
                    text: "Cancel";
                    text-size: 16px;
                    clicked => {
                        State.cancel-logout();
                    }
                }
                PrimaryButton {
                    height: 40px;
                    text: "Log out";
                    clicked => {
                        State.confirm-logout();
                    }
                }
            }
        }
    }
}
