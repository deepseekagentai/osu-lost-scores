import { T } from "theme.slint";
import { State } from "state.slint";
import { HoverBox, IconButton, PrimaryButton, SecondaryButton, Stat, Toggle, ScoresBox } from "widgets.slint";
import { TipArea } from "widgets.slint";

component StatValue inherits HorizontalLayout {
    in property <string> now;
    in property <string> potential;
    in property <string> unit;
    spacing: 4px;
    Text {
        text: root.now;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
    if root.potential != "": Text {
        text: "→";
        color: T.arrow;
        font-size: 16px;
        vertical-alignment: bottom;
    }
    if root.potential != "": Text {
        text: root.potential;
        color: T.acc;
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
    if root.unit != "": Text {
        text: root.unit;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
}

component Connect inherits VerticalLayout {
    padding: 24px;
    spacing: 10px;
    Text {
        text: "Connect your account";
        color: #ffffff;
        font-size: 22px;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Rectangle { height: 4px; }
    PrimaryButton {
        text: "Log in with osu!";
        enabled: false;
        tip: "Arrives with the Lost Scores server";
    }
    Text {
        text: "or";
        color: T.k;
        font-size: 14px;
        horizontal-alignment: center;
    }
    SecondaryButton {
        text: "Use Custom API Keys";
        enabled: !State.busy;
        tip: "For advanced users with their own osu! API credentials";
        clicked => {
            State.open-keys();
        }
    }
}

component Profile inherits HorizontalLayout {
    padding-left: 20px;
    padding-right: 26px;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: 20px;
    VerticalLayout {
        alignment: start;
        Rectangle {
            width: 120px;
            height: 120px;
            border-radius: 16px;
            background: T.field;
            if State.has-avatar: Image {
                source: State.avatar;
                width: 120px;
                height: 120px;
                image-fit: fill;
            }
        }
    }
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 40px;
                name := Text {
                    width: parent.width;
                    text: State.user-name;
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TipArea {
                    tip: State.user-name;
                    anchor: parent.absolute-position;
                    anchor-height: parent.height;
                }
            }
            IconButton {
                icon: @image-url("../assets/i-user-pen.svg");
                tip: "Change user";
                enabled: !State.busy;
                clicked => {
                    State.open-keys();
                }
            }
            IconButton {
                icon: @image-url("../assets/i-door.svg");
                tip: "Log out";
                enabled: !State.busy;
                clicked => {
                    State.ask-logout();
                }
            }
        }
        if !State.stats-ready: Text {
            text: "Fetching initial stats...";
            color: T.k;
            font-size: 14px;
            font-italic: true;
            vertical-alignment: center;
            min-height: 38px;
        }
        if State.stats-ready: HorizontalLayout {
            spacing: 20px;
            alignment: start;
            Stat {
                label: "Performance";
                StatValue {
                    now: State.perf-now;
                    potential: State.perf-potential;
                    unit: "pp";
                }
            }
            Stat {
                label: "Accuracy";
                StatValue {
                    now: State.acc-now;
                    potential: State.acc-potential;
                }
            }
            Stat {
                label: "Global rank";
                StatValue { now: State.rank; }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Toggle {
                icon-off: @image-url("../assets/i-check.svg");
                icon-on: @image-url("../assets/i-xmark.svg");
                tip: "Include unranked and loved beatmaps";
                on: State.include-all;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-include-all(value);
                }
            }
            Toggle {
                icon-off: @image-url("../assets/i-mag-x.svg");
                icon-on: @image-url("../assets/i-mag.svg");
                tip: "Check missing beatmap IDs (may take a long time)";
                on: State.check-missing;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-check-missing(value);
                }
            }
            Toggle {
                icon-off: @image-url("../assets/i-eye-slash.svg");
                icon-on: @image-url("../assets/i-eye.svg");
                tip: "Ensure at least one lost score is visible in the top plays image";
                on: State.show-lost;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-show-lost(value);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Scores to show:";
                color: T.k2;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            ScoresBox {
                value: State.scores-to-show;
                outside: State.outside-clicks;
                enabled: !State.busy;
                commit(text) => {
                    State.commit-scores(text);
                }
            }
        }
    }
}

export component AccountCard inherits HoverBox {
    preferred-height: inner.preferred-height;
    border-radius: 12px;
    background: T.card;
    inner := VerticalLayout {
        if !State.connected: Connect { }
        if State.connected: Profile { }
    }
}
