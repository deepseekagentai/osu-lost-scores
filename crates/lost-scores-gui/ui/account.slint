import { T } from "theme.slint";
import { State } from "state.slint";
import { HoverBox, IconButton, PrimaryButton, SecondaryButton, Stat, Toggle, ScoresBox, HintArea } from "widgets.slint";

component StatValue inherits HorizontalLayout {
    in property <string> now;
    in property <string> potential;
    in property <string> unit;
    in property <int> tone;
    spacing: 4px;
    Text {
        text: root.now;
        color: #ffffff;
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
    if root.potential != "": Text {
        text: "→";
        color: T.arrow;
        font-size: 16px;
        vertical-alignment: bottom;
    }
    if root.potential != "": Text {
        text: root.potential;
        color: root.tone > 0 ? T.up : (root.tone < 0 ? T.down : #ffffff);
        font-size: 16px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
    if root.unit != "": Text {
        text: root.unit;
        color: #ffffff;
        font-size: 12px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
}

component NameField inherits Rectangle {
    height: 44px;
    border-radius: 8px;
    background: T.field;
    border-width: 2px;
    border-color: T.acc;
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text: State.user-name;
        color: #ffffff;
        font-size: 26px;
        font-weight: 600;
        vertical-alignment: center;
        single-line: true;
        enabled: !State.name-busy;
        init => {
            self.focus();
            self.select-all();
        }
        accepted => {
            State.change-player(self.text);
        }
    }
}

component Avatar inherits VerticalLayout {
    alignment: start;
    Rectangle {
        width: 120px;
        height: 120px;
        Rectangle {
            x: round(parent.absolute-position.x / 4px) * 4px - parent.absolute-position.x;
            y: round(parent.absolute-position.y / 4px) * 4px - parent.absolute-position.y;
            width: 120px;
            height: 120px;
            border-radius: 16px;
            background: T.field;
            if State.has-avatar: Image {
                x: 0px;
                y: 0px;
                source: State.avatar;
                width: 120px;
                height: 120px;
                image-fit: fill;
                image-rendering: pixelated;
            }
        }
    }
}

component Connect inherits HorizontalLayout {
    padding-left: 20px;
    padding-right: 26px;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: 20px;
    Avatar { }
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: "Connect your account";
            color: #ffffff;
            font-size: 22px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Rectangle { height: 4px; }
        PrimaryButton {
            text: State.logging-in ? "Waiting for the browser..." : "Log in with osu!";
            enabled: !State.busy;
            tip: State.logging-in ? "Finish the login in the browser, or click to open it again" : "Log in with your osu! account in the browser";
            clicked => {
                State.log-in();
            }
        }
        Text {
            text: "or";
            color: T.k;
            font-size: 14px;
            horizontal-alignment: center;
        }
        SecondaryButton {
            text: "Use Custom API Keys";
            enabled: !State.busy;
            tip: "For advanced users with their own osu! API credentials";
            clicked => {
                State.open-keys();
            }
        }
    }
}

component Profile inherits HorizontalLayout {
    padding-left: 20px;
    padding-right: 26px;
    padding-top: 20px;
    padding-bottom: 20px;
    spacing: 20px;
    Avatar { }
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 1;
                min-width: 40px;
                if !State.editing-name: Text {
                    width: parent.width;
                    text: State.user-name;
                    color: #ffffff;
                    font-size: 30px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !State.editing-name: HintArea {
                    tip: State.user-name;
                    anchor: parent.absolute-position;
                    anchor-height: parent.height;
                }
                if State.editing-name: NameField { }
            }
            if !State.logged-in: IconButton {
                icon: @image-url("../assets/i-user-pen.svg");
                tip: "Change player: name, ID or profile link";
                enabled: !State.busy && !State.name-busy;
                clicked => {
                    State.editing-name = !State.editing-name;
                }
            }
            IconButton {
                icon: @image-url("../assets/i-door.svg");
                tip: "Log out";
                enabled: !State.busy;
                clicked => {
                    State.ask-logout();
                }
            }
        }
        if !State.stats-ready: Text {
            text: "Fetching initial stats...";
            color: T.k;
            font-size: 14px;
            font-italic: true;
            vertical-alignment: center;
            min-height: 38px;
        }
        if State.stats-ready: HorizontalLayout {
            spacing: 20px;
            alignment: start;
            Stat {
                label: "Performance";
                StatValue {
                    now: State.perf-now;
                    potential: State.perf-potential;
                    tone: State.perf-tone;
                    unit: "pp";
                }
            }
            Stat {
                label: "Accuracy";
                StatValue {
                    now: State.acc-now;
                    potential: State.acc-potential;
                    tone: State.acc-tone;
                }
            }
            Stat {
                label: "Global rank";
                StatValue { now: State.rank; }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Toggle {
                icon: @image-url("../assets/i-heart.svg");
                tip: "Include unranked and loved beatmaps";
                on: State.include-all;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-include-all(value);
                }
            }
            Toggle {
                icon: @image-url("../assets/i-cloud-down.svg");
                tip: "Check missing beatmap IDs (may take a long time)";
                on: State.check-missing;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-check-missing(value);
                }
            }
            Toggle {
                icon: @image-url("../assets/i-image.svg");
                tip: "Ensure at least one lost score is visible in the top plays image";
                on: State.show-lost;
                enabled: !State.busy;
                toggled(value) => {
                    State.set-show-lost(value);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Scores to show:";
                color: T.k2;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
            }
            ScoresBox {
                value: State.scores-to-show;
                outside: State.outside-clicks;
                pending <=> State.scores-pending;
                enabled: !State.busy;
                commit(text) => {
                    State.commit-scores(text);
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                icon: @image-url("../assets/i-trash.svg");
                tip: "Clear cache";
                enabled: !State.busy;
                clicked => {
                    State.ask-clear-cache();
                }
            }
            IconButton {
                icon: @image-url("../assets/i-rotate.svg");
                tip: "Check for updates";
                enabled: !State.checking-updates;
                clicked => {
                    State.check-updates();
                }
            }
        }
    }
}

export component AccountCard inherits HoverBox {
    preferred-height: inner.preferred-height;
    max-height: inner.preferred-height;
    vertical-stretch: 0;
    border-radius: 12px;
    background: T.card;
    inner := VerticalLayout {
        if !State.connected: Connect { }
        if State.connected: Profile { }
    }
}
