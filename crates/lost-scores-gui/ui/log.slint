import { T } from "theme.slint";
import { State } from "state.slint";
import { HoverBox, HintArea } from "widgets.slint";

export component LastLogLine inherits Rectangle {
    property <string> message: State.log.length > 0 ? State.log[State.log.length - 1].text : "";
    height: line.preferred-height;
    line := Text {
        width: parent.width;
        text: root.message;
        color: T.logt;
        font-size: 12.5px;
        font-italic: true;
        horizontal-alignment: center;
        overflow: elide;
    }
    HintArea {
        tip: root.message;
        anchor: root.absolute-position;
        anchor-height: root.height;
    }
}

export component LogBox inherits HoverBox {
    min-height: 64px;
    preferred-height: 112px;
    vertical-stretch: 1;
    border-radius: 10px;
    background: T.field;
    property <length> content: lines.preferred-height + 16px;
    changed content => {
        flick.content-y = Math.min(0px, flick.height - root.content);
    }
    flick := Flickable {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        content-width: self.width;
        content-height: root.content;
        lines := TextInput {
            x: 12px;
            y: 8px;
            width: flick.width - 24px;
            text: State.log-text;
            read-only: true;
            single-line: false;
            wrap: word-wrap;
            color: T.logt;
            font-size: 12.5px;
            font-italic: true;
            selection-background-color: T.acc.with-alpha(0.45);
            selection-foreground-color: #ffffff;
        }
    }
}
